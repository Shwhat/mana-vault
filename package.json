{
  "name": "mana-vault",
  "private": true,
  "version": "0.39.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev:server": "npm run dev -w @mana-vault/server",
    "dev:web": "npm run dev -w @mana-vault/web",
    "update:cards": "npm run import:cards -w @mana-vault/server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:wiki && npm run test --workspaces --if-present",
    "test:wiki": "node --test scripts/wiki-guide.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:run": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
