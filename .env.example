# Mana Vault settings. In Dockhand, enter these as the stack's environment variables.
# On the command line, copy this file to .env and edit it. Never commit .env.

# Host port the app is published on. Check it is free first: sudo ss -ltnp | grep ':3417 '
MANAVAULT_PORT=3417

# Folder on the Docker host that holds the database. Must be owned by 65532:65532.
MANAVAULT_DATA_DIR=/opt/mana-vault/data

# Folder on the Docker host that holds the downloaded card pictures. Must be owned by 65532:65532.
# Pictures can take many GB; this folder can be on a different drive from the database.
MANAVAULT_PICTURES_HOST=/opt/mana-vault/pictures

# The settings below are normally set in Administration. Setting one here locks it there.

# Who can create accounts: open, invite (one-time invite codes) or closed. Leave empty to set it in Administration.
MANAVAULT_SIGNUP=

# auto (the default) marks the sign-in cookie secure when the request arrived over HTTPS (such as through Cloudflare Tunnel).
# always or never force it.
MANAVAULT_SECURE_COOKIE=

# Hours between automatic card database updates from Scryfall. 0 turns them off. Leave empty to set it in Administration.
MANAVAULT_CARD_UPDATE_INTERVAL_HOURS=

# Time zone for server logs.
TZ=America/Los_Angeles

# Optional Playmat engine. Start with docker compose --profile play up -d --build
# Set this to ws://play-engine:17172 with the profile enabled; leave it empty otherwise.
# Keep the private subnet and container addresses free of conflicts with other Docker/VPN networks.
# If changed, keep both container addresses inside the subnet.
MANAVAULT_PLAY_ENGINE_SUBNET=172.30.254.0/29
MANAVAULT_PLAY_APP_IP=172.30.254.2
MANAVAULT_PLAY_ENGINE_IP=172.30.254.3
# Leave empty until the private engine profile is enabled.
MANAVAULT_PLAYMAT_URL=
MANAVAULT_PLAYMAT_TIMEOUT_MS=15000
